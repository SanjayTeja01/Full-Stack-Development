rules_version = '2';

// Product images: public to read, writable only by the owning farmer, images only, at most 5 MB.
// Files are referenced from product documents by Cloud Functions, which check the path prefix.
service firebase.storage {
  match /b/{bucket}/o {
    match /products/{farmerId}/{uploadId}/{fileName} {
      allow read: if true;
      allow create: if request.auth != null
        && request.auth.uid == farmerId
        && request.auth.token.role == 'farmer'
        && request.resource.size < 5 * 1024 * 1024
        && request.resource.contentType.matches('image/(jpeg|png|webp)');
      allow delete: if request.auth != null && request.auth.uid == farmerId;
      allow update: if false;
    }
    match /avatars/{userId}/{fileName} {
      allow read: if true;
      allow create: if request.auth != null && request.auth.uid == userId
        && request.resource.size < 2 * 1024 * 1024
        && request.resource.contentType.matches('image/(jpeg|png|webp)');
      allow delete: if request.auth != null && request.auth.uid == userId;
    }
    match /{allPaths=**} {
      allow read, write: if false;
    }
  }
}
