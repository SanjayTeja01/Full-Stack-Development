# ---- Public Firebase web config (safe to expose; security comes from rules and the server) ----
NEXT_PUBLIC_FIREBASE_API_KEY=
NEXT_PUBLIC_FIREBASE_AUTH_DOMAIN=your-project.firebaseapp.com
NEXT_PUBLIC_FIREBASE_PROJECT_ID=your-project
NEXT_PUBLIC_FIREBASE_STORAGE_BUCKET=your-project.firebasestorage.app
NEXT_PUBLIC_FIREBASE_MESSAGING_SENDER_ID=
NEXT_PUBLIC_FIREBASE_APP_ID=
NEXT_PUBLIC_FIREBASE_FUNCTIONS_REGION=asia-south1

# Where trusted operations run: "api" (default, free plan: this app's /api/rpc routes) or "functions" (Blaze: Cloud Functions)
NEXT_PUBLIC_BACKEND_MODE=api
# Where product photos go: "blob" (default, Vercel Blob, free) or "firebase" (Cloud Storage, needs Blaze for new buckets)
NEXT_PUBLIC_IMAGE_STORAGE=blob

# App Check (optional; leave both empty to disable). A free reCAPTCHA v3 key works; Enterprise is used if set.
NEXT_PUBLIC_RECAPTCHA_V3_SITE_KEY=
NEXT_PUBLIC_RECAPTCHA_ENTERPRISE_SITE_KEY=

# Shown on the contact page
NEXT_PUBLIC_SUPPORT_EMAIL=

# ---- Server-only secrets (set in Vercel → Project → Settings → Environment Variables; NEVER prefix with NEXT_PUBLIC_) ----
# The whole service-account JSON from Firebase console → Project settings → Service accounts → Generate new private key.
# Paste the JSON as one line, or base64-encode it. Anyone with this key has full admin access to your project.
FIREBASE_SERVICE_ACCOUNT_KEY=
# Long random string; the cron caller must send "Authorization: Bearer <CRON_SECRET>". Generate with: openssl rand -hex 32
CRON_SECRET=
# Added automatically when you connect a Vercel Blob store to the project.
BLOB_READ_WRITE_TOKEN=
# Minimum auction duration in minutes (default 15).
AUCTION_MIN_DURATION_MINUTES=15
# Require App Check tokens on /api/rpc (set true only after App Check tokens are arriving).
ENFORCE_APP_CHECK=false

# ---- Local development only ----
# Set to true to use the Firebase Emulator Suite instead of a real project.
NEXT_PUBLIC_USE_FIREBASE_EMULATORS=false
NEXT_PUBLIC_FIREBASE_EMULATOR_HOST=127.0.0.1
