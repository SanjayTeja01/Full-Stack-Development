NEXT_PUBLIC_USE_FIREBASE_EMULATORS=true
NEXT_PUBLIC_FIREBASE_PROJECT_ID=demo-farmconnect
NEXT_PUBLIC_FIREBASE_STORAGE_BUCKET=demo-farmconnect.appspot.com
NEXT_PUBLIC_FIREBASE_EMULATOR_HOST=127.0.0.1
# Server-side (Next.js API routes): point the Admin SDK at the local emulators.
FIRESTORE_EMULATOR_HOST=127.0.0.1:8080
FIREBASE_AUTH_EMULATOR_HOST=127.0.0.1:9099
FIREBASE_STORAGE_EMULATOR_HOST=127.0.0.1:9199
GCLOUD_PROJECT=demo-farmconnect
# Allow very short auctions locally so bidding can be demonstrated and tested quickly.
AUCTION_MIN_DURATION_MINUTES=1
