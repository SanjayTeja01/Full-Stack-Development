{
  "compilerOptions": {
    "target": "ES2022",
    "module": "commonjs",
    "moduleResolution": "node",
    "strict": true,
    "noUnusedLocals": true,
    "esModuleInterop": true,
    "skipLibCheck": true,
    "resolveJsonModule": true,
    "noEmit": true,
    "types": ["node"],
    "baseUrl": ".",
    "paths": {
      "@shared/*": ["../shared/*"],
      "zod": ["./node_modules/zod"],
      "firebase-admin/*": ["./node_modules/firebase-admin/lib/*"]
    }
  },
  "include": ["src", "../server", "../shared"]
}
